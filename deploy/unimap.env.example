# Settings for every unimap service on the VPS. install.sh copies this to
# /etc/unimap/unimap.env (mode 600) on first run; edit it there.

# Public site. Caddy gets a TLS certificate for it; point its DNS A record at the VPS first.
# Messages wallets sign to log in name it, and the API turns away browsers on other origins.
DOMAIN=unimap.example.com

# Where the chain, the ord indexes and Postgres live. Needs ~2 TB of NVMe (see deploy/README.md).
DATA_DIR=/data

# Bitcoin Core RPC, local only. Pick a long random password (letters, digits, . _ - only).
BITCOIN_RPC_URL=http://127.0.0.1:8332/
BITCOIN_RPC_USER=unimap
BITCOIN_RPC_PASSWD=change-me

# Postgres (OPI bitmap_index, parcel_index and the API share one database).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=unimap
DB_USER=unimap
DB_PASSWD=change-me-too

NETWORK_TYPE=mainnet
# OPI's ord fork (index run) serves its inscription reader here.
DB_READER_API_URL=http://127.0.0.1:11030/
# Upstream ord 0.23.2 server, used for owners and inscription counts.
ORD_API_URL=http://127.0.0.1:8080/
# OPI's bitmap_index: don't report blocks to OPI's public dashboard.
REPORT_TO_INDEXER=false

# Wallet holdings shown as pets on the map (api/holdings.py). Hiro's public API by default;
# a key raises its rate limit.
HOLDINGS_API_URL=https://api.hiro.so
HOLDINGS_API_KEY=

# Linking X accounts (api/xlink.py). Make a Web App in the X developer portal with the
# callback https://$DOMAIN/x/callback, then fill these in; left empty, linking is off.
X_CLIENT_ID=
X_CLIENT_SECRET=

# Districts for sale (api/listings.py): listings from Magic Eden's Ordinals API, refreshed every
# 10 minutes while people look at the map. Ask Magic Eden for an API key; without one requests
# may be rate limited or refused. LISTINGS_COLLECTION is the collection symbol there.
LISTINGS_API_URL=https://api-mainnet.magiceden.dev
LISTINGS_API_KEY=
LISTINGS_COLLECTION=bitmap

# Site admins (api/moderation.py): addresses, comma separated, that handle reported posts and ban
# addresses from posting at /admin. Left empty, reports pile up with no one to read them.
ADMIN_ADDRESSES=

# Per-IP limits on API writes, a minute (api/app.py): any POST/PUT/PATCH/DELETE, and asking for
# a sign-in nonce plus signing in. Each of the 2 API workers counts on its own. 0 turns one off.
RATE_LIMIT_WRITES=60
RATE_LIMIT_AUTH=20

# The web app calls the API on the same origin (Caddy sends /v1/* to it), so no CORS is needed.
API_CORS_ORIGINS=

# 站内交易 (api/market.py): buying and selling with PSBTs. Off unless MARKET_NETWORK is set.
# Run it on a test network first (testnet4, signet or regtest, with bitcoind and ord on that
# network; ord needs --index-addresses so a buyer's coins can be found). Mainnet stays off
# until MARKET_MAINNET_AUDITED=1, which is for after the outside security audit.
MARKET_NETWORK=
MARKET_MAINNET_AUDITED=
# unimap's fee, in basis points of the price (100 = 1%), paid to MARKET_FEE_ADDRESS. Empty: none.
MARKET_FEE_BPS=
MARKET_FEE_ADDRESS=

# 街区 agent (api/agent.py): drafts posts for districts whose owners switch it on. Off unless
# ANTHROPIC_API_KEY is set. AGENT_MODEL picks the model (default claude-sonnet-5-5).
ANTHROPIC_API_KEY=
AGENT_MODEL=
# What owners pay over Lightning for each 30 days, to AGENT_LIGHTNING_ADDRESS (whose wallet must
# support LUD-21 verify, so payments can be confirmed). Empty: free.
AGENT_PRICE_SATS=
AGENT_LIGHTNING_ADDRESS=
# Model calls a day (a run makes up to 8), per owner (their linked wallets together) and for the
# whole server. Past either, agents stop until the next day. Empty: 60 and 2000.
AGENT_DAILY_CALLS_PER_OWNER=
AGENT_DAILY_CALLS_TOTAL=

# 收费开关 (api/billing.py, docs/monetization.md). Everything below is off while empty.
# Where unimap's own products are paid. A product sells once it has a price and at least one of these.
# PLATFORM_BTC_ADDRESS: a P2TR, P2WPKH or P2SH address that buyers' wallets (UniSat, Xverse, OKX)
# send to on-chain; the default way to pay. Each payment asks for the price plus 1-99 sats of its
# own, so a transaction says which payment it is for. Checked with bitcoind (BITCOIN_RPC_URL,
# txindex); a payment seen in the mempool counts. Empty: no on-chain payments.
PLATFORM_BTC_ADDRESS=
# PLATFORM_LIGHTNING_ADDRESS: offered as the second way (LUD-21 verify needed); empty: AGENT_LIGHTNING_ADDRESS.
PLATFORM_LIGHTNING_ADDRESS=
# Prices in sats; empty or 0: not for sale. STYLE sells premium style options (needs BILLING_COSMETICS=1);
# PROMOTION sells a home-page slot for a district, which waits for an admin to approve it.
BILLING_PRICE_STYLE_SATS=
BILLING_PRICE_PROMOTION_SATS=
# CAPSULE sells 时间胶囊「封存」 (suggested 2000): up to 100 years, a photo, envelope styles, a notice when
# it opens. While it sells, each wallet gets one free capsule (text only, within a year); while it
# doesn't, every capsule is free with no limits, as before. CAPSULE_INSCRIBE_SATS is only the price
# shown for 刻上链, which isn't open yet (empty: 20000). Like every product it sells only once
# PLATFORM_BTC_ADDRESS or a Lightning address is set above; empty it to keep capsules free.
BILLING_PRICE_CAPSULE_SATS=2000
CAPSULE_INSCRIBE_SATS=
# 礼物 (api/gift.py): sats sent with a capsule, locked by Bitcoin until a block. Test networks only:
# signet, testnet or testnet4; empty (or anything else, mainnet included) turns gifts off. The tip
# that releases unimap's backup half comes from GIFT_BITCOIN_RPC_* (a node on that network) and/or
# GIFT_ESPLORA_URL (empty: mempool.space for the network; off: don't ask), the lower if both answer.
GIFT_NETWORK=
GIFT_ESPLORA_URL=
GIFT_BITCOIN_RPC_URL=
GIFT_BITCOIN_RPC_USER=
GIFT_BITCOIN_RPC_PASSWD=
GIFT_MAX_SATS=
# 1: style options marked premium in api/style.py need the entitlement style:<option>. None are marked yet.
BILLING_COSMETICS=
# A sponsor named with the season's prize pool on /game; the link must be https.
GAME_SEASON_POOL_SATS=
GAME_SEASON_SPONSOR_NAME=
GAME_SEASON_SPONSOR_URL=
# Writes a minute for a request with a valid X-API-Key (issued by admins); per tier with
# RATE_LIMIT_KEY_WRITES_<TIER>, e.g. RATE_LIMIT_KEY_WRITES_PRO. Empty: 600.
RATE_LIMIT_KEY_WRITES=
