[Unit]
Description=unimap: upstream ord 0.23.2 server (owners, inscription counts)
After=unimap-bitcoind.service
Requires=unimap-bitcoind.service

[Service]
User=unimap
Group=unimap
EnvironmentFile=/etc/unimap/unimap.env
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
# Sandboxing: everything is read-only except the directory it writes (install.sh fills in @DATA_DIR@).
ProtectSystem=strict
ReadWritePaths=@DATA_DIR@/ord
ProtectHome=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# RPC credentials as ORD_BITCOIN_RPC_* so they stay off the command line.
EnvironmentFile=/etc/unimap/ord.env
LimitNOFILE=65536
ExecStart=/opt/unimap/bin/ord --data-dir ${DATA_DIR}/ord server --address 127.0.0.1 --http-port 8080
TimeoutStopSec=300

[Install]
WantedBy=multi-user.target
