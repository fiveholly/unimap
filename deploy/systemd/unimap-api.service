[Unit]
Description=unimap: API (land + social)
After=postgresql.service unimap-bitcoind.service

[Service]
User=unimap
Group=unimap
EnvironmentFile=/etc/unimap/unimap.env
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
# Sandboxing: it writes nothing but the database, so the filesystem is read-only.
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
WorkingDirectory=/opt/unimap/src
Environment=PYTHONPATH=/opt/unimap/src
ExecStart=/opt/unimap/venv/bin/python3 -m uvicorn api.app:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers

[Install]
WantedBy=multi-user.target
