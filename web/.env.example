# Where the unimap API (uvicorn api.app:app) listens. The API must allow this site's
# origin: set API_CORS_ORIGINS=http://localhost:3000 for the API.
NEXT_PUBLIC_API_URL=http://localhost:8000
# The site's own public address, used in shared links and their card images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Demo site only (NEXT_PUBLIC_DEMO=1): the shared capsule envelope's inscription id on signet, as
# CAPSULE_ENVELOPE_INSCRIPTION on a server. Empty: inscribed letters show the fallback SVG.
NEXT_PUBLIC_CAPSULE_ENVELOPE_INSCRIPTION=
